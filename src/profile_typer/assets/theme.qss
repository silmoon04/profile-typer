QWidget { color: #20231f; }
QToolTip { background: #20231f; color: #fffef9; border: 0; padding: 6px; }
QPushButton, QToolButton {
    background: #fffef9; border: 1px solid #20231f; border-bottom-width: 2px;
    border-radius: 2px; padding: 5px 10px; font-weight: 600;
}
QPushButton:hover, QToolButton:hover { background: #e9edda; }
QPushButton:pressed, QToolButton:pressed { background: #d9f266; border-bottom-width: 1px; padding-top: 6px; }
QPushButton:focus, QToolButton:focus { border: 2px solid #526521; padding: 4px 9px; }
QPushButton:disabled, QToolButton:disabled { color: #7b7e73; border-color: #b8bcaf; background: #efeee6; }
QPushButton#primary { background: #20231f; color: #fffef9; }
QPushButton#primary:hover { background: #3e4930; }
QPushButton#primary:pressed { background: #526521; }
QPushButton#primary:disabled { background: #e4e5da; color: #7b7e73; border-color: #b8bcaf; }
QPushButton#stop:enabled { background: #f4c6bc; border-color: #983d2c; }
QToolButton#quiet { border: 0; background: transparent; padding: 3px 5px; color: #62665c; }
QToolButton#quiet:hover, QToolButton#quiet:checked { color: #20231f; background: #e4e8d7; }
QLineEdit, QComboBox, QDoubleSpinBox {
    border: 1px solid #a4aa9a; border-radius: 2px; background: #fffef9; padding: 4px 6px;
    selection-background-color: #d9f266; selection-color: #20231f;
}
QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus { border-color: #20231f; background: #ffffff; }
QLineEdit#view-title { font-size: 23px; font-weight: 700; padding: 3px 0; border: 0; border-bottom: 2px solid #20231f; background: transparent; }
QLineEdit#view-title:focus { border-bottom-color: #677d2d; background: #fffef9; }
QDoubleSpinBox { padding: 2px 3px; }
QComboBox::drop-down { width: 22px; border-left: 1px solid #bcc1b2; }
QComboBox::down-arrow { image: url("@assets/chevron-down.png"); width: 10px; height: 10px; }
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button { width: 16px; border: 0; background: #eff0e7; }
QDoubleSpinBox::up-arrow { image: url("@assets/chevron-up.png"); width: 8px; height: 8px; }
QDoubleSpinBox::down-arrow { image: url("@assets/chevron-down.png"); width: 8px; height: 8px; }
QPlainTextEdit { border: 1px solid #20231f; border-radius: 2px; background: #fffef9; padding: 8px; }
QPlainTextEdit:focus { border: 1px solid #677d2d; }
QTextEdit#field-value { background: #fffef9; border: 0; border-bottom: 1px solid #c4c9ba; border-radius: 0; padding: 3px 4px; }
QTextEdit#field-value:focus { background: #ffffff; border-bottom: 1px solid #4a6220; }
QListView { border: 0; background: transparent; outline: 0; }
QSplitter::handle { background: #c7cbbd; width: 1px; }
QTabBar::tab { background: transparent; color: #62665c; border: 0; border-bottom: 2px solid transparent; padding: 6px 16px; }
QTabBar::tab:selected { color: #20231f; border-bottom-color: #20231f; font-weight: 700; }
QTabBar::tab:hover { background: #e9edda; }
QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: #e5e7dc; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #838b74; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #20231f; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QProgressBar { border: 0; background: #dfe4d4; max-height: 5px; }
QProgressBar::chunk { background: #627f27; }
QLabel#preview { color: #465d20; font-size: 11px; }
QLabel#brand { font-size: 15px; font-weight: 700; }
QLabel#eyebrow { color: #62665c; font-size: 11px; font-weight: 600; }
QLabel#status { color: #62665c; font-size: 11px; }
QLabel#settings-title { font-size: 18px; font-weight: 700; padding-top: 8px; padding-bottom: 4px; }
QWidget#control-dock { border-top: 1px solid #20231f; }
QMenu { border: 1px solid #20231f; padding: 4px; background: #fffef9; }
QMenu::item { padding: 7px 20px; }
QMenu::item:selected { background: #d9f266; }
QMenu::item:disabled { color: #7b7e73; }
QCheckBox, QRadioButton { spacing: 6px; }
QWidget#workspace[dense="true"] QPushButton, QWidget#workspace[dense="true"] QToolButton { padding: 2px 6px; }
QWidget#workspace[dense="true"] QTabBar::tab { padding: 3px 12px; }
QWidget#workspace[dense="true"] QLineEdit#view-title { font-size: 18px; padding: 1px 0; }
QWidget#workspace[dense="true"] QLineEdit, QWidget#workspace[dense="true"] QComboBox { padding: 2px 4px; }
